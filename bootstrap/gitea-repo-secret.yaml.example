# ArgoCD needs credentials to read the homelab-gitops repo from Gitea (assume private repo).
# This is a second manual-apply artifact, same class as root-app.yaml, and for the same reason:
# it has to exist before GitOps can manage anything, including itself.
#
# DO NOT commit this file with real values filled in, and do not git-track the filled-in version
# anywhere, even in this repo. Copy it out, fill it in, apply it directly, delete the copy:
#
#   cmd.exe:
#     copy gitea-repo-secret.yaml.example %TEMP%\gitea-repo-secret.yaml
#     :: edit %TEMP%\gitea-repo-secret.yaml with real values
#     kubectl apply -f %TEMP%\gitea-repo-secret.yaml
#     del %TEMP%\gitea-repo-secret.yaml
#
#   PowerShell:
#     cp gitea-repo-secret.yaml.example $env:TEMP\gitea-repo-secret.yaml
#     # edit $env:TEMP\gitea-repo-secret.yaml with real values
#     kubectl apply -f $env:TEMP\gitea-repo-secret.yaml
#     rm $env:TEMP\gitea-repo-secret.yaml
#
# Generate the token in Gitea: Settings -> Applications -> Generate New Token, scope: repo (read).
# Use a token, not your Gitea account password.
#
# This plaintext-secret-via-kubectl-apply pattern is a deliberate, temporary trade-off for Week 2 —
# Sealed Secrets doesn't exist until Week 5. Worth noting explicitly in the eventual writeup as
# another "documented, accepted trade-off," same spirit as the root-SSH-on-Proxmox note in the
# Week 1 notes.

apiVersion: v1
kind: Secret
metadata:
  name: homelab-gitops-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: http://gitea-http.gitea.svc.cluster.local:3000/<gitea-username>/homelab-gitops.git
  username: <gitea-username>
  password: <gitea-access-token>
